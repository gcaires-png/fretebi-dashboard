# NDD Averba — credenciais e endpoints (copiar para .env e preencher)
# NUNCA commitar o .env com valores reais.

# URL base da API (autenticação documentada em reader.nddaverba.com.br).
# Confirmar no helpcenter (https://helpcenter.nddaverba.com.br/pt/apis/current)
# ou com a NDD (0800-461-0000) se a averbação usa esta mesma base.
NDD_AVERBA_BASE_URL=https://reader.nddaverba.com.br

# Usuário de integração (mesmo login do portal NDD Averba ou usuário criado para integração)
NDD_AVERBA_EMAIL=
NDD_AVERBA_SENHA=

# Opcional: sobrescrever caminhos dos endpoints se o Swagger indicar diferente
# NDD_AVERBA_PATH_AUTH=/api/usuario/auth
# NDD_AVERBA_PATH_AVERBAR=/api/averbacao/cte
